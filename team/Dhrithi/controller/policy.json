{
  "default_policy": "deny",
  "roles": {
    "user": {
      "services": [
        {
          "ip": "10.0.0.5",
          "port": 8000,
          "protocol": "TCP",
          "name": "web"
        }
      ]
    },
    "admin": {
      "services": [
        {
          "ip": "10.0.0.5",
          "port": 8000,
          "protocol": "TCP",
          "name": "web"
        },
        {
          "ip": "10.0.0.6",
          "port": 8001,
          "protocol": "TCP",
          "name": "admin"
        }
      ]
    }
  },
  "security": {
    "max_failed_attempts": 3,
    "block_duration": 60,
    "default_session_ttl": 60,
    "max_session_ttl": 300
  },
  "monitoring": {
    "stats_interval": 2,
    "scan_threshold": 20,
    "scan_window": 10
  }
}
